# ---- FICHIER DE PROJET DE LA SALLE -----

# On importe tous les éléments (classes, fonctions, variables...) du système de Jenga
from Jenga import *

# Création du projet. Encadré dans un "with" afin de garantir l'utilisation et le cleanup des ressources.
with project("Salle") :
    windowedapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/**.cpp", "include/**.hpp"])
